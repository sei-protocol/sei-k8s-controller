apiVersion: chaos-mesh.org/v1alpha1
kind: TimeChaos
metadata:
  name: time-skew-forward-{{.RunID}}
  namespace: {{.Namespace}}
  labels:
    sei.io/harness-run: "{{.RunID}}"
spec:
  # Skew one validator's clock +1m. time-skew only goes backwards (-30s); a
  # clock ahead of its peers is the other direction timestamp and timeout logic
  # has to survive. One validator (1/4 power) is outvoted on the median-vote
  # block time, so the chain stays live.
  mode: one
  selector:
    namespaces: ["{{.Namespace}}"]
    expressionSelectors:
      - {key: sei.io/nodedeployment, operator: In, values: ["{{.ChainID}}"]}
  timeOffset: "+1m"
  clockIds: ["CLOCK_REALTIME"]
  containerNames: ["seid"]
  duration: "{{.Duration}}"
