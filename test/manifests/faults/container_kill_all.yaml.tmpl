apiVersion: chaos-mesh.org/v1alpha1
kind: PodChaos
metadata:
  name: container-kill-all-{{.RunID}}
  namespace: {{.Namespace}}
  labels:
    sei.io/harness-run: "{{.RunID}}"
spec:
  # One-shot SIGKILL of the seid container in EVERY validator at once: a cold
  # start of the whole chain. Beyond f=1 by design: no quorum survives, so the
  # chain halts until enough validators have recovered from their own WALs and
  # state stores. Every validator restarts independently and they can come back
  # at different heights, so this is the case that exercises recovery agreeing
  # across nodes, not just on one.
  action: container-kill
  mode: all
  containerNames: ["seid"]
  selector:
    namespaces: ["{{.Namespace}}"]
    expressionSelectors:
      - {key: sei.io/nodedeployment, operator: In, values: ["{{.ChainID}}"]}
