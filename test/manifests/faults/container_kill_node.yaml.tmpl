apiVersion: chaos-mesh.org/v1alpha1
kind: PodChaos
metadata:
  name: container-kill-node-{{.RunID}}
  namespace: {{.Namespace}}
  labels:
    sei.io/harness-run: "{{.RunID}}"
spec:
  # One-shot SIGKILL of the seid container of ONE named node (Params.Node). The
  # other kill faults select validators through sei.io/nodedeployment, which RPC
  # followers do not carry; this one pins sei.io/node to the node's own name, so
  # it reaches a follower: for example a node that is mid block sync or mid
  # state sync when the kill lands. Render rejects a name outside the run's
  # chain, and namespaces pins the run's namespace, so the selector cannot reach
  # another chain's pods.
  action: container-kill
  mode: one
  containerNames: ["seid"]
  selector:
    namespaces: ["{{.Namespace}}"]
    expressionSelectors:
      - {key: sei.io/node, operator: In, values: ["{{.Node}}"]}
