apiVersion: chaos-mesh.org/v1alpha1
kind: PodChaos
metadata:
  name: pod-clean-stop-{{.RunID}}
  namespace: {{.Namespace}}
  labels:
    sei.io/harness-run: "{{.RunID}}"
spec:
  # One-shot graceful stop of one validator pod: the pod is deleted with a grace
  # period, so the kubelet sends SIGTERM, waits, and sends SIGKILL only if seid
  # is still running. pod-failure and container-kill both use gracePeriod 0, so
  # without this fault the SIGTERM shutdown path is never exercised. The same
  # path a rolling restart or an upgrade takes.
  #
  # gracePeriod is a placeholder: set it to the termination grace period the
  # controller renders for SeiNode pods, so a clean stop has the time a real
  # rollout gives it.
  action: pod-kill
  mode: one
  gracePeriod: 60
  selector:
    namespaces: ["{{.Namespace}}"]
    expressionSelectors:
      - {key: sei.io/nodedeployment, operator: In, values: ["{{.ChainID}}"]}
